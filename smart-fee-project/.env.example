# ============================================================================
# Smart Fee - Environment Configuration
# 
# Instructions:
# 1. Copy this file and rename to: .env
# 2. Update the values below with your configuration
# 3. This .env file is used by all services (backend, frontend, etc.)
# 4. DO NOT COMMIT .env to Git - it's added to .gitignore
# 5. For production, use strong, unique values for all secrets
# ============================================================================

# ---- DATABASE CONFIGURATION ----
# MySQL must be running before starting the backend
# Options: 
#   - Local: jdbc:mysql://localhost:3306/smartfee_db
#   - Docker: jdbc:mysql://db:3306/smartfee_db (when using docker-compose)

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smartfee_db?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=smartfee
SPRING_DATASOURCE_PASSWORD=smartfee

# ---- SECURITY CONFIGURATION ----
# JWT Secret: Used to sign authentication tokens
# IMPORTANT: Generate a strong random secret for production!
# You can generate one with: openssl rand -base64 32
JWT_SECRET=0DMjSf5IVIRo4UwCbVDT75RS4hRE0xXfULif093u2iEkKfZc85KLv2vI+aNLi6leOpx/lkPt0G/SAGFQYSboig==

# Payment Webhook Secret: Used to verify payment gateway callbacks
# IMPORTANT: Must match your payment provider's webhook secret
# This is validated using HMAC-SHA256 signature verification
PAYMENT_WEBHOOK_SECRET=test_webhook_secret

# ---- DOCKER-SPECIFIC SETTINGS ----
# These are used ONLY when running with docker-compose
# Ignored when running backend locally without Docker

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=smartfee_db
MYSQL_USER=smartfee
MYSQL_PASSWORD=smartfee

# ---- DEVELOPMENT SETTINGS ----
# API Base URL for frontend
VITE_API_URL=http://localhost:8080/api

# Server port (default: 8080)
SERVER_PORT=8080

